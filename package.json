{
  "name": "farmcon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "apply-rls": "node scripts/apply-rls-policies.js",
    "db:setup": "prisma db push && npm run apply-rls",
    "postinstall": "prisma generate",
    "apollo:publish": "~/.rover/bin/rover graph publish $APOLLO_GRAPH_REF --schema ./schema.graphql",
    "apollo:check": "~/.rover/bin/rover graph check $APOLLO_GRAPH_REF --schema ./schema.graphql",
    "apollo:fetch": "~/.rover/bin/rover graph fetch $APOLLO_GRAPH_REF",
    "backup:db": "tsx scripts/backup-database.ts",
    "backup:health": "tsx scripts/backup-database.ts --health-check"
  },
